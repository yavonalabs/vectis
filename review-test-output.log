                    </button>
                    <button type="submit" class="px-4 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-semibold rounded-lg text-xs transition shadow-lg shadow-rose-600/30">
                        Confirm Delete
                    </button>
                </div>
            </form>
        </div>
