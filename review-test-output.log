               class="px-2.5 py-1 bg-[#0f1117] border border-white/10 rounded-lg hover:bg-[#151821] transition text-[#9ca3af] hover:text-white" hx-get="/admin/employee?page=1&amp;search=&amp;sort=&amp;dir=asc&amp;size=0">
                Next &rarr;
            </a>
        </div>
