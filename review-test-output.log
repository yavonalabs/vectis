             Body = <!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overview - Vectis Console</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- htmx -->
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    
    <!-- Alpine.js Plugins -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/anchor@3.x.x/dist/cdn.min.js"></script>
    <!-- Alpine.js Core -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        :root {
            --vx-canvas: #090a0f;
            --vx-surface-base: #0f1117;
            --vx-surface-card: #151821;
            --vx-surface-overlay: #1c202c;
            --vx-surface-active: #232838;
            --vx-border: rgba(255, 255, 255, 0.08);
            --vx-border-subtle: rgba(255, 255, 255, 0.04);
            --vx-text-main: #f3f4f6;
            --vx-text-muted: #9ca3af;
            --vx-text-faint: #6b7280;
            --vx-accent: #10b981;
            --vx-accent-main: #10b981;
            --vx-accent-hover: #059669;
            --vx-accent-glow: rgba(16, 185, 129, 0.15);
        }

        body {
            background-color: var(--vx-canvas);
            color: var(--vx-text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            letter-spacing: -0.011em;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Type Badges */
        .type-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            background-color: #1a1e29;
            color: #9ca3af;
            border: 1px solid rgba(255, 255, 255, 0.06);
            text-transform: lowercase;
            font-weight: 500;
        }

        /* Tiered Risk Badges */
        .risk-badge-low { color: #10b981; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); }
        .risk-badge-moderate { color: #f59e0b; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); }
        .risk-badge-impact { color: #f97316; background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.25); }
        .risk-badge-danger { color: #ef4444; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); }

        /* Toast Notifications */
        .toast {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #151821;
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 12px 18px;
            border-radius: 10px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
            z-index: 1000;
            transform: translateX(400px);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .toast.show { transform: translateX(0); }

        .htmx-indicator { display: none; }
        .htmx-request .htmx-indicator { display: inline-block; }
        .htmx-request.htmx-indicator { display: inline-block; }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row bg-[#090a0f] text-[#f3f4f6]" 
      x-data="globalSearch()"
      @open-peek-drawer.window="peekDrawerOpen = true">

    <!-- Mobile Top Header -->
    <div class="md:hidden flex items-center justify-between bg-[#0f1117] px-4 py-3 border-b border-white/10">
        <a href="/admin" class="flex items-center gap-2 font-bold text-sm text-white">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            <span>Vectis Console</span>
        </a>
        <button onclick="document.getElementById('sidebar').classList.toggle('hidden')" class="p-1.5 text-[#9ca3af] hover:text-white">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>

    <!-- Sidebar: Obsidian Surface -->
    <aside id="sidebar" class="hidden md:flex w-64 bg-[#0f1117] border-r border-white/10 flex-col shrink-0">
        <!-- Brand Header -->
        <div class="h-14 flex items-center px-4 border-b border-white/10 justify-between">
            <a href="/admin" class="flex items-center gap-2.5 font-bold text-sm tracking-tight text-white">
                <div class="w-6 h-6 rounded-lg bg-[#10b981] flex items-center justify-center text-[#090a0f] font-black text-xs shadow-lg shadow-[#10b981]/20">V</div>
                <span>Vectis Console</span>
            </a>
        </div>

        <!-- Navigation Sections -->
        <nav class="flex-1 px-3 py-4 space-y-6 overflow-y-auto">
            
            <!-- OVERVIEW -->
            <div>
                <a href="/admin" 
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs transition bg-[#151821] text-[#10b981] font-semibold border-l-2 border-[#10b981]">
                    <svg class="w-4 h-4 text-[#9ca3af]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                    </svg>
                    <span>Overview</span>
                </a>
            </div>

            <!-- TABLE EDITOR (DATA) -->
            <div>
