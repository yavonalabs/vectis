    <!-- Safe Action Modal (Vectis Risk & Justification Flow) -->
    <div id="action-modal" 
         x-data="{
             loadingPreview: false,
             previewData: null,
             actionId: '',
             entityId: '',
             slug: '',
             reasonProvided: '',
             
             async fetchPreview() {
                 this.loadingPreview = true;
                 this.previewData = null;
                 try {
                     const formData = new FormData();
                    const csrfInput = document.querySelector('#modal-action-form input[name=\\'_csrf\\']');
                    if (csrfInput) {
                        formData.append(csrfInput.name, csrfInput.value);
                    }
                    
                    const response = await fetch(`/admin/api/${this.slug}/action/${this.actionId}/${this.entityId}/preview`, {
                        method: 'POST',
                        body: formData
                    });
                     if (response.ok) {
                         this.previewData = await response.json();
                     } else {
                         console.error('Preview request failed');
                     }
                 } catch (e) {
                     console.error('Preview failed', e);
                 } finally {
                     this.loadingPreview = false;
                 }
             }
         }"
         @open-action-modal.window="slug = $event.detail.slug; actionId = $event.detail.actionId; entityId = $event.detail.entityId; fetchPreview(); $el.classList.remove('hidden');"
         class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-[#0f1117] border border-white/15 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-5">
            <div class="flex items-start gap-3">
                <div class="p-2.5 bg-[#10b981]/10 rounded-xl border border-[#10b981]/25 text-[#10b981]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div>
                    <h3 id="action-modal-title" class="text-sm font-semibold text-white">Execute Operation</h3>
                    <p class="text-xs mt-0.5 font-bold" 
                       :class="{
                           'text-[#9ca3af]': !previewData || previewData.riskLevel === 'LOW',
                           'text-amber-400': previewData?.riskLevel === 'MODERATE',
                           'text-orange-400': previewData?.riskLevel === 'HIGH',
                           'text-red-400': previewData?.riskLevel === 'CRITICAL'
                       }"
                       x-text="previewData ? `Risk Assessment: ${previewData.riskLevel}` : 'Risk Assessment: ...'">Risk Assessment: Moderate</p>
                </div>
            </div>
            
            <div class="p-3.5 bg-[#151821] rounded-xl border border-white/5 text-xs text-[#9ca3af] space-y-3">
                <div>
                    <div class="text-white font-medium mb-1">What will happen?</div>
                    <p id="action-modal-desc" class="text-[11px] leading-relaxed mb-3">Operation will be executed with full transactional logging.</p>

                    <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-3 text-[10.5px] text-amber-500/90 mb-3 leading-relaxed flex gap-2">
                        <span class="text-base leading-none">??</span>
                        <div>
                            <span class="font-bold text-amber-500">Preview Warning:</span> This dry run simulates the action and safely rolls back all database changes. However, <strong>any external side-effects (like emails or APIs) coded into this action by your developers may still execute.</strong> Use with caution.
                        </div>
                    </div>
                </div>
                
                <!-- State Preview / Dry Run Box -->
                <div class="space-y-2 pt-2 border-t border-white/5">
                    <div class="text-[10px] font-bold uppercase tracking-wider text-[#6b7280] flex items-center justify-between">
                        <span>State Preview</span>
                        <!-- Loading Spinner -->
                        <div x-show="loadingPreview" class="flex items-center gap-1.5 text-amber-500">
                            <svg class="animate-spin h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Simulating Dry Run...</span>
                        </div>
                    </div>

                    <!-- Diff Results -->
                    <div x-show="!loadingPreview && previewData" class="space-y-2 font-mono text-[10px]">
                        <!-- Changes detected -->
                        <template x-if="previewData?.hasChanges">
                            <div class="space-y-1 bg-[#090a0f] p-2 rounded-lg border border-white/5 max-h-32 overflow-y-auto">
                                <template x-for="(change, idx) in previewData.plainTextChanges" :key="idx">
                                    <div class="flex items-center gap-2 py-1 border-b border-white/5 last:border-0">
                                        <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        <span class="text-[#f3f4f6] text-xs font-medium" x-text="change"></span>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- No changes -->
                        <div x-show="previewData && !previewData.hasChanges" class="p-2 rounded bg-[#10b981]/10 border border-[#10b981]/20 text-[#10b981] flex items-center gap-2 font-semibold">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            No database fields will be modified.
                        </div>
                    </div>
                </div>
            </div>

            <form id="modal-action-form" method="post" action="">
                <input type="hidden" name="_csrf" value="uEpePUjqZVtI0mzRmNu5-l7SYo1_-CvMgUxoHjRubC-N0kxPiShnDHrSUmxl5lTk_vaNzmbqT7RLzkjh5S9QLVFaVRi8s3V7" />
                <div class="space-y-1.5" x-show="previewData?.riskLevel === 'MODERATE' || previewData?.riskLevel === 'HIGH' || previewData?.riskLevel === 'CRITICAL'">
                    <label for="action-reason" class="text-xs font-medium text-white">
                        Reason / Justification (Required for Audit) <span class="text-rose-400">*</span>
                    </label>
                    <input id="action-reason" name="_reason" x-model="reasonProvided" :required="previewData?.riskLevel === 'MODERATE' || previewData?.riskLevel === 'HIGH' || previewData?.riskLevel === 'CRITICAL'" type="text" placeholder="e.g. Ticket #1042 - Approved by Operations" 
                           class="w-full bg-[#090a0f] border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-[#6b7280] focus:outline-none focus:border-[#10b981] transition" />
                </div>
                <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-white/10">
                    <button type="button" onclick="document.getElementById('action-modal').classList.add('hidden')" class="px-3.5 py-1.5 bg-[#151821] hover:bg-[#1c202c] text-[#9ca3af] hover:text-white rounded-lg text-xs font-medium transition border border-white/5">
                        Cancel
                    </button>
                    <button type="submit" id="action-modal-btn" 
                            :disabled="loadingPreview || ((previewData?.riskLevel === 'MODERATE' || previewData?.riskLevel === 'HIGH' || previewData?.riskLevel === 'CRITICAL') && !reasonProvided)"
                            :class="(loadingPreview || ((previewData?.riskLevel === 'MODERATE' || previewData?.riskLevel === 'HIGH' || previewData?.riskLevel === 'CRITICAL') && !reasonProvided)) ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#059669] shadow-lg shadow-[#10b981]/20'"
                            class="px-4 py-1.5 bg-[#10b981] text-[#090a0f] font-bold rounded-lg text-xs transition">
                        Confirm &amp; Execute
                    </button>
                </div>
            </form>
        </div>
    </div>

