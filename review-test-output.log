            </div>
            <p class="text-xs text-[#9ca3af]">Are you sure you want to delete record <span id="modal-record-id" class="font-mono font-bold text-white"></span>?</p>
            <form id="modal-delete-form" method="post" action="">
                <input type="hidden" name="_csrf" value="uaMdAcAJCI57aBfyLyqjisRAMPGJ3nPj4PK5Co6KuwVxjRVU35YrMqE5PrpWUSfBTQeX6_Z1HZC7uhbO2ZDda--z2WNG73Fh" />
                <div class="space-y-1.5">
                    <label for="delete-reason" class="text-xs font-medium text-white">Reason for Deletion <span class="text-rose-400">*</span></label>
                    <input id="delete-reason" name="_reason" required type="text" placeholder="e.g. User account closed" 
                           class="w-full bg-[#090a0f] border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-[#6b7280] focus:outline-none focus:border-rose-500 transition" />
                </div>
                <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-white/10">
